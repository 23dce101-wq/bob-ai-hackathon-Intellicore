# PortPredict AI — backend environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ─── AI Provider ─────────────────────────────────────────────────────────────
# WatsonX (primary) + Ollama (fallback) are both configured.
# Set WatsonX credentials for cloud AI. Ollama works without credentials.

# IBM watsonx.ai (cloud)
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_guid_here
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Ollama (local fallback — install from ollama.ai)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/portpredict

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# CORS — restrict to your frontend origin in production
# ALLOWED_ORIGIN=https://your-deployed-frontend.com
